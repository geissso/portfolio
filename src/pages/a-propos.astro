---
import BaseLayout from "../layouts/BaseLayout.astro";

const parcours = [
  {
    periode: "2024 - Aujourd'hui",
    titre: "BUT Métiers du Multimédia et de l'Internet",
    lieu: "IUT Nord Franche-Comté, Montbéliard",
    description: "Design, communication, développement web et audiovisuel : le parcours actuel qui relie toutes mes envies."
  },
  {
    periode: "2023 - 2024",
    titre: "Design graphique",
    lieu: "École de Condé",
    description: "Une année pour approfondir la culture graphique, la composition et la direction artistique."
  },
  {
    periode: "2023",
    titre: "Baccalauréat technologique STD2A",
    lieu: "Lycée Charles de Gaulle, Chaumont",
    description: "Design et arts appliqués : les bases du dessin, de la couleur et de la démarche de projet."
  }
];

const experiences = [
  {
    periode: "Alternance 2026 - 2027",
    titre: "Chargée de communication & Evenementiel - Le Cnam BFC",
    type: "Alternance",
    href:"https://www.cnam-bourgognefranchecomte.fr/"
  },
  {
    periode: "2026 - Aujourd'hui",
    titre: "Association audiovisuel CAPS",
    type: "Bénévolat",
    href: "/caps"
  },
  {
    periode: "2025 - Aujourd'hui",
    titre: "Designeuse pour le BDE MMI",
    type: "Bénévolat",
    href: "/bde"
  },
  
];

const competences = [
  {
    label: "Design",
    items: ["Identité visuelle", "Affiches & print", "Illustration", "Contenus réseaux sociaux"]
  },
  {
    label: "UI / UX",
    items: ["Conception d'interfaces", "Maquettes & prototypes", "Ergonomie"]
  },
  {
    label: "Développement",
    items: ["HTML / CSS", "JavaScript", "Intégration frontend"]
  }
];

const outils = ["Photoshop", "Illustrator", "Figma", "VS Code"];

const interets = ["Arts", "Sport automobile", "Musique", "Jeux vidéo"];

const photo = "/images/photo_soso.png";
---

<BaseLayout title="À propos - Portfolio" description="Qui je suis : parcours, compétences et centres d'intérêt de Solène Geiss.">
  <div class="floating-photo hidden lg:block" data-floating-photo aria-hidden="true">
    <p class="speech-bubble" data-speech-bubble></p>
    <div class="floating-photo__tilt" data-floating-photo-tilt>
      <div class="floating-photo__wiggle">
        <img src={photo} alt="" class="h-full w-full rounded-full object-cover" />
      </div>
    </div>
  </div>

  <section class="relative container px-6 pt-32 pb-16 md:pb-24 overflow-hidden">
    <img
      src="/images/gradient-blob.png"
      alt=""
      width="800"
      height="800"
      class="absolute -top-40 -right-24 lg:-right-32 w-[600px] opacity-30 pointer-events-none select-none blur-sm"
      aria-hidden="true"
    />

    <div class="relative grid grid-cols-1 gap-8 md:gap-12 md:grid-cols-[1.3fr_1fr] md:items-center animate-slide-in">
      <div>
        <div class="flex items-center gap-3 mb-6">
          <div class="h-px w-12 bg-foreground"></div>
          <span class="text-xs font-body uppercase tracking-[0.3em] text-muted-foreground">À propos</span>
        </div>

        <h1 class="font-heading text-5xl sm:text-6xl md:text-7xl leading-[0.9] text-foreground mb-8">
          Entre passion<br />
          et la <span class="italic">créativité.</span>
        </h1>

        <div class="space-y-4 max-w-xl text-base font-body text-muted-foreground leading-relaxed">
          <p>
            Je m'appelle Solène, j'ai 21 ans et je suis étudiante en Métiers du Multimédia et de l'Internet à Montbéliard.
            Depuis le collège, je dessine, je compose et je cherche la bonne image pour dire les choses simplement.
          </p>
          <p>
            Aujourd'hui, je relie cette sensibilité graphique au numérique : conception d'interfaces, contenus pour les
            réseaux sociaux et développement frontend. J'aime quand un projet est à la fois beau, lisible et agréable à utiliser.
          </p>
        </div>

        <div class="mt-10 flex flex-wrap items-center gap-6">
          <a
            href="/images/cv_geiss_solene.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-sm font-body text-primary hover:text-primary/80 transition-colors uppercase tracking-widest"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Ouvrir mon CV
          </a>
          <a
            href="/contact"
            class="px-8 py-3 bg-foreground text-background text-xs font-body uppercase tracking-widest hover:opacity-80 transition-opacity"
          >
            Me contacter
          </a>
        </div>
      </div>

      <div
        class="order-first flex items-center justify-start md:order-none md:justify-center lg:min-h-[28rem] lg:items-end"
        data-photo-slot
        data-says="Salut, moi c'est <span class='text-primary italic'>Solène</span> !"
      >
        <img
          src={photo}
          alt="Photo de Solène Geiss"
          class="h-32 w-32 rounded-full border border-border object-cover shadow-lg sm:h-40 sm:w-40 md:h-56 md:w-56 lg:h-64 lg:w-64 lg:invisible"
        />
      </div>
    </div>
  </section>

  <div class="container px-6 pb-24 space-y-20 md:space-y-28">
    <!-- Photo à gauche de la timeline -->
    <section class="grid grid-cols-1 gap-8 lg:gap-10 lg:grid-cols-[1fr_2fr]">
      <div class="flex flex-col">
        <p class="text-xs font-body uppercase tracking-[0.3em] text-muted-foreground mb-4">Parcours</p>
        <h2 class="font-heading text-4xl md:text-5xl text-foreground lg:sr-only">
          D'où je <span class="text-primary italic">viens</span>.
        </h2>
        <div class="photo-slot hidden lg:block" data-photo-slot></div>
      </div>

      <ol class="relative border-l border-border space-y-10 pl-8">
        {
          parcours.map((etape) => (
            <li class="relative">
              <span class="absolute -left-[37px] top-1.5 h-2.5 w-2.5 rounded-full bg-secondary"></span>
              <p class="text-xs font-body uppercase tracking-[0.25em] text-muted-foreground mb-2">{etape.periode}</p>
              <h3 class="font-heading text-2xl md:text-3xl text-foreground mb-1">{etape.titre}</h3>
              <p class="text-sm font-body text-foreground/85 mb-2">{etape.lieu}</p>
              <p class="text-sm font-body leading-relaxed text-muted-foreground max-w-xl">{etape.description}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- Photo à droite des expériences -->
    <section class="grid grid-cols-1 gap-8 lg:gap-10 lg:grid-cols-[2fr_1fr]">
      <div class="flex flex-col lg:order-2">
        <p class="text-xs font-body uppercase tracking-[0.3em] text-muted-foreground mb-4">Expériences</p>
        <h2 class="font-heading text-4xl md:text-5xl text-foreground lg:sr-only">
          Toutes mes <span class="text-primary italic">expériences</span>.
        </h2>
        <div class="photo-slot hidden lg:block" data-photo-slot></div>
      </div>

      <ul class="divide-y divide-border border-y border-border lg:order-1">
        {
          experiences.map((experience) => {
            const content = (
              <div class="flex flex-col gap-1 py-5 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
                <div>
                  <p class="text-xs font-body uppercase tracking-[0.25em] text-muted-foreground mb-1">{experience.type}</p>
                  <p class="font-heading text-xl md:text-2xl text-foreground group-hover:text-primary transition-colors">
                    {experience.titre}
                  </p>
                </div>
                <p class="flex items-center gap-2 text-xs font-body uppercase tracking-wider text-muted-foreground shrink-0">
                  {experience.periode}
                  {experience.href && (
                    <svg class="h-4 w-4 text-foreground transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M5 12h14"></path>
                      <path d="m12 5 7 7-7 7"></path>
                    </svg>
                  )}
                </p>
              </div>
            );

            return (
              <li>
                {experience.href ? (
                  <a href={experience.href} class="group block" aria-label={`Découvrir l'expérience ${experience.titre}`}>
                    {content}
                  </a>
                ) : (
                  content
                )}
              </li>
            );
          })
        }
      </ul>
    </section>

    <!-- Photo à gauche des compétences -->
    <section class="grid grid-cols-1 gap-8 lg:gap-10 lg:grid-cols-[1fr_2fr]">
      <div class="flex flex-col">
        <p class="text-xs font-body uppercase tracking-[0.3em] text-muted-foreground mb-4">Compétences</p>
        <h2 class="font-heading text-4xl md:text-5xl text-foreground lg:sr-only">
          Ce que je sais <span class="text-primary italic">faire</span>.
        </h2>
        <div class="photo-slot hidden lg:block" data-photo-slot></div>
      </div>

      <div class="border border-border bg-card/60 overflow-hidden">
        <div class="grid grid-cols-1 sm:grid-cols-3 divide-y divide-border sm:divide-y-0 sm:divide-x">
          {
            competences.map((groupe) => (
              <div class="p-6 md:p-8">
                <p class="text-xs font-body uppercase tracking-[0.25em] text-muted-foreground mb-4">{groupe.label}</p>
                <ul class="space-y-2">
                  {groupe.items.map((item) => (
                    <li class="font-body text-sm leading-relaxed text-foreground/85">{item}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <div class="border-t border-border p-6 md:p-8">
          <p class="text-xs font-body uppercase tracking-[0.25em] text-muted-foreground mb-4">Outils</p>
          <ul class="flex flex-wrap gap-2">
            {
              outils.map((outil) => (
                <li class="rounded-sm border border-border bg-background/80 px-3 py-1.5 text-xs font-body uppercase tracking-wider text-foreground">
                  {outil}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<script is:inline>
  // Sur PC, la photo glisse d'un emplacement [data-photo-slot] à l'autre au fil du scroll.
  const floatingPhoto = document.querySelector("[data-floating-photo]");
  const floatingTilt = document.querySelector("[data-floating-photo-tilt]");
  const bubble = document.querySelector("[data-speech-bubble]");
  const slots = Array.from(document.querySelectorAll("[data-photo-slot]"));
  const desktop = window.matchMedia("(min-width: 1024px)");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  let current = null;
  let frame = null;
  let activeSlot = null;
  let bubbleTimeout = null;

  // La phrase vient de data-says, sinon du titre h2 de la section
  const getPhrase = (slot) => slot.dataset.says || slot.parentElement.querySelector("h2")?.innerHTML || "";

  const setPhrase = (slot) => {
    if (slot === activeSlot) return;
    const isFirst = activeSlot === null;
    activeSlot = slot;
    clearTimeout(bubbleTimeout);

    if (isFirst || reducedMotion.matches) {
      bubble.innerHTML = getPhrase(slot);
      return;
    }

    bubble.classList.add("is-switching");
    bubbleTimeout = setTimeout(() => {
      bubble.innerHTML = getPhrase(slot);
      bubble.classList.remove("is-switching");
    }, 180);
  };

  const getTarget = () => {
    const size = floatingPhoto.offsetWidth;
    const radius = size / 2;
    const viewportCenter = window.innerHeight / 2;

    // Emplacement le plus proche du centre de l'ecran
    let best = null;
    let bestSlot = null;
    let bestDistance = Infinity;
    slots.forEach((slot) => {
      const rect = slot.getBoundingClientRect();
      if (rect.width === 0) return;
      const distance =
        viewportCenter < rect.top ? rect.top - viewportCenter : viewportCenter > rect.bottom ? viewportCenter - rect.bottom : 0;
      if (distance < bestDistance) {
        bestDistance = distance;
        best = rect;
        bestSlot = slot;
      }
    });

    if (!best) return null;
    setPhrase(bestSlot);

    // On garde la place de la bulle au-dessus de la photo
    const bubbleSpace = bubble.offsetHeight + 24;
    const minY = best.top + bubbleSpace + radius;
    const maxY = Math.max(minY, best.bottom - radius);
    const centerY = Math.min(Math.max(viewportCenter, minY), maxY);

    return { x: best.left + best.width / 2 - radius, y: centerY - radius };
  };

  const render = () => {
    frame = null;
    const target = getTarget();
    if (!target) return;

    if (!current || reducedMotion.matches) {
      current = { ...target };
    } else {
      current.x += (target.x - current.x) * 0.1;
      current.y += (target.y - current.y) * 0.1;
    }

    const velocityX = target.x - current.x;
    const tilt = Math.max(-14, Math.min(14, velocityX * 0.04));

    floatingPhoto.style.transform = `translate3d(${current.x}px, ${current.y}px, 0)`;
    floatingTilt.style.transform = `rotate(${tilt}deg)`;

    const settled = Math.abs(target.x - current.x) < 0.5 && Math.abs(target.y - current.y) < 0.5;
    if (!settled) requestUpdate();
  };

  const requestUpdate = () => {
    if (!desktop.matches || frame) return;
    frame = requestAnimationFrame(render);
  };

  if (floatingPhoto && slots.length > 0) {
    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener("resize", () => {
      current = null;
      requestUpdate();
    });
    desktop.addEventListener("change", () => {
      current = null;
      requestUpdate();
    });
    requestUpdate();
  }
</script>

<style>
  .floating-photo {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 40;
    width: 16rem;
    height: 16rem;
    pointer-events: none;
    will-change: transform;
  }

  .floating-photo__tilt {
    width: 100%;
    height: 100%;
    transition: transform 200ms ease-out;
  }

  .floating-photo__wiggle {
    width: 100%;
    height: 100%;
    border-radius: 9999px;
    border: 1px solid hsl(var(--border));
    box-shadow: 0 18px 40px -18px hsl(var(--foreground) / 0.45);
    animation: soso-wiggle 2.6s ease-in-out infinite;
  }

  .photo-slot {
    flex: 1;
    min-height: 26rem;
  }

  .speech-bubble {
    position: absolute;
    bottom: calc(100% + 1.25rem);
    left: 50%;
    width: max-content;
    max-width: 19rem;
    margin: 0;
    padding: 0.9rem 1.25rem;
    border: 1px solid hsl(var(--border));
    border-radius: 1.25rem;
    background: hsl(var(--card));
    color: hsl(var(--foreground));
    font-family: "Instrument Serif", serif;
    font-size: 1.9rem;
    line-height: 1.05;
    text-align: center;
    box-shadow: 0 18px 40px -22px hsl(var(--foreground) / 0.5);
    transform: translateX(-50%);
    transform-origin: 50% 100%;
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .speech-bubble::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    width: 1rem;
    height: 1rem;
    margin-top: -0.5rem;
    border-right: 1px solid hsl(var(--border));
    border-bottom: 1px solid hsl(var(--border));
    background: hsl(var(--card));
    transform: translateX(-50%) rotate(45deg);
  }

  .speech-bubble.is-switching {
    opacity: 0;
    transform: translateX(-50%) scale(0.85);
  }

  @keyframes soso-wiggle {
    0%,
    100% {
      transform: rotate(0deg) translate(0, 0);
    }
    15% {
      transform: rotate(-3deg) translate(-1px, -2px);
    }
    30% {
      transform: rotate(2.5deg) translate(1px, 0);
    }
    45% {
      transform: rotate(-1.5deg) translate(0, 1px);
    }
    60% {
      transform: rotate(1deg) translate(0, -1px);
    }
    75% {
      transform: rotate(0deg) translate(0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-photo__wiggle {
      animation: none;
    }
  }
</style>
