				>
					<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<polyline points="15 18 9 12 15 6"></polyline>
					</svg>
					Retour
				</a>
				<div>
					<p class="text-xs font-body uppercase tracking-[0.3em] text-white/80 mb-3">Experience benevole</p>
					<h1 class="font-heading text-5xl md:text-7xl text-white mb-3">CAPS</h1>
					<p class="font-body text-sm md:text-base text-white/90 max-w-xl">
						Engagement associatif, communication sensible et creations au service du collectif.
					</p>
				</div>
			</div>
		</section>

		<div class="container px-6 pt-14 md:pt-20 space-y-16 md:space-y-24">
			<section class="space-y-6">
				<div>
					<p class="text-xs font-body uppercase tracking-[0.25em] text-muted-foreground">Roles au sein de CAPS</p>
					<h2 class="font-heading text-4xl md:text-5xl text-foreground mt-2">Mes missions sur le terrain</h2>
					<p class="font-body text-base text-foreground/80 mt-4 max-w-3xl">
						Je suis polyvalente sur ces missions: ces roles se completent et ne representent pas un ordre d'importance.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-5">
					<article class="border border-border bg-card/60 overflow-hidden">
						<div class="aspect-[4/3] overflow-hidden">
							<img
								src="/images/commentatrice_caps.webp"
								alt="Role de commentatrice a CAPS"
								class="h-full w-full object-cover"
								loading="lazy"
							/>
						</div>
						<div class="p-5 space-y-2">
							<p class="text-xs font-body uppercase tracking-[0.25em] text-muted-foreground">Commentatrice</p>
							<p class="font-body text-base text-foreground">Commentatrice</p>
							<p class="font-body text-sm leading-relaxed text-foreground/80">
								Presentation des actions de l'association pendant les evenements, mise en contexte des temps forts et transmission d'une parole claire et accessible au public.
							</p>
						</div>
					</article>

					<article class="border border-border bg-card/60 overflow-hidden">
						<div class="aspect-[4/3] overflow-hidden">
							<img
								src="/images/logistique_caps.webp"
								alt="Role logistique a CAPS"
								class="h-full w-full object-cover"
								loading="lazy"
							/>
						</div>
						<div class="p-5 space-y-2">
							<p class="text-xs font-body uppercase tracking-[0.25em] text-muted-foreground">Logistique</p>
							<p class="font-body text-base text-foreground">Logistique</p>
							<p class="font-body text-sm leading-relaxed text-foreground/80">
								Preparation des espaces, coordination des besoins materiels et suivi operationnel pour garantir un deroulement fluide des activites de CAPS.
							</p>
						</div>
					</article>

					<article class="border border-border bg-card/60 overflow-hidden">
						<div class="aspect-[4/3] overflow-hidden">
							<img
								src="/images/hero_caps1.webp"
								alt="Role regie et realisation a CAPS"
								class="h-full w-full object-cover"
								loading="lazy"
							/>
						</div>
						<div class="p-5 space-y-2">
							<p class="text-xs font-body uppercase tracking-[0.25em] text-muted-foreground">Regie / real</p>
							<p class="font-body text-base text-foreground">Regie / real</p>
							<p class="font-body text-sm leading-relaxed text-foreground/80">
								Gestion de la regie et appui a la realisation pour capter les moments cles, assurer la coherence visuelle et soutenir la diffusion des contenus.
							</p>
						</div>
					</article>
				</div>
			</section>

			<section class="w-screen relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] px-6 md:px-10 py-12 md:py-16">
				<div class="mx-auto max-w-none space-y-6">
					<div class="container px-0">
						<p class="text-xs font-body uppercase tracking-[0.25em] text-muted-foreground">Apercu video</p>
						<p class="font-body text-sm text-foreground/80 max-w-2xl">
							Clique sur jouer pour lancer la video CAPS directement sur la page.
						</p>
					</div>

					{hasCapsVideo && (
						<div class="space-y-4" id="capsVideoSection" data-provider={videoProvider}>
							<button
								type="button"
								id="capsVideoPreview"
								class="group relative block w-full overflow-hidden"
								aria-label="Lancer la video CAPS"
							>
								<img
									src={capsVideoPreview}
									alt="Apercu video CAPS"
									class="w-full h-[58vh] md:h-[72vh] object-cover transition-transform duration-500 group-hover:scale-[1.02]"
								/>
								<div class="absolute inset-0 bg-black/35 group-hover:bg-black/25 transition-colors"></div>
								<div class="absolute inset-0 flex items-center justify-center">
									<span class="inline-flex items-center gap-3 bg-white/90 px-5 py-3 text-sm font-body uppercase tracking-wider text-black">
										<svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
											<polygon points="8,5 19,12 8,19"></polygon>
										</svg>
										Jouer la video
									</span>
								</div>
							</button>

							{videoProvider === "file" ? (
								<video
									id="capsVideoPlayer"
									class="hidden w-full h-[58vh] md:h-[72vh] object-contain bg-black"
									controls
									playsinline
									preload="metadata"
									src={capsVideoUrl}
								></video>
							) : (
								<iframe
									id="capsVideoPlayer"
									class="hidden w-full h-[58vh] md:h-[72vh] bg-black"
									title="Video CAPS"
									src={capsVideoEmbedUrl}
									allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
									allowfullscreen
								></iframe>
							)}
						</div>
					)}
				</div>
			</section>

			<section class="border border-border bg-card/60 overflow-hidden">
				<div class="grid grid-cols-1 md:grid-cols-3 divide-y divide-border md:divide-y-0 md:divide-x">
					<div class="p-6 md:p-8">
						<div class="inline-flex h-8 w-8 items-center justify-center rounded-sm border border-border text-muted-foreground">
							<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" d="M12 21s6.75-3.75 6.75-10.5A6.75 6.75 0 0 0 5.25 10.5C5.25 17.25 12 21 12 21z" />
								<path stroke-linecap="round" stroke-linejoin="round" d="M12 12a2.25 2.25 0 1 0 0-4.5 2.25 2.25 0 0 0 0 4.5z" />
							</svg>
						</div>
						<div class="mt-4 space-y-2">
							<p class="text-xs font-body uppercase tracking-[0.25em] text-muted-foreground">Contexte</p>
							<p class="font-body text-sm leading-relaxed text-foreground/85">
								CAPS est une association a mission sociale. Sa communication doit être accessible, bienveillante et en phase avec les publics qu'elle accompagne.
							</p>
						</div>
					</div>
					<div class="p-6 md:p-8">
						<div class="inline-flex h-8 w-8 items-center justify-center rounded-sm border border-border text-muted-foreground">
							<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" d="M4.5 20.25l6.75-6.75m-4.5-4.5 8.25-5.25L20.25 9l-5.25 8.25-6.75 2.25-3.75-3.75z" />
							</svg>
						</div>
						<div class="mt-4 space-y-2">
							<p class="text-xs font-body uppercase tracking-[0.25em] text-muted-foreground">Approche</p>
							<p class="font-body text-sm leading-relaxed text-foreground/85">
								Valorisations des actions, creation de contenus sensibles, supports informatifs et visuels inclusifs et touchants.
							</p>
						</div>
					</div>
					<div class="p-6 md:p-8">
						<div class="inline-flex h-8 w-8 items-center justify-center rounded-sm border border-border text-muted-foreground">
							<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12a8.25 8.25 0 1 1 16.5 0 8.25 8.25 0 0 1-16.5 0z" />
								<path stroke-linecap="round" stroke-linejoin="round" d="M12 9.75v4.5M12 16.5h.008" />
							</svg>
						</div>
						<div class="mt-4 space-y-2">
							<p class="text-xs font-body uppercase tracking-[0.25em] text-muted-foreground">Valeur ajoutée</p>
							<p class="font-body text-sm leading-relaxed text-foreground/85">
								Communication plus humaine, meilleure lisibilite des actions et renforcement de l'image de CAPS comme acteur solidaire.
							</p>
						</div>
					</div>
				</div>
			</section>

			<section class="grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-8 items-start">
				<div class="space-y-5">
					<div class="border border-border bg-card/60 overflow-hidden">
						<div class="p-6 md:p-8">
							<div class="inline-flex h-8 w-8 items-center justify-center rounded-sm border border-border text-muted-foreground">
								<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5h15M6 16.5h12M7.5 4.5h9v10.5h-9zM9 7.5h6M9 10.5h6" />
								</svg>
							</div>
							<div class="mt-4 space-y-2">
								<p class="text-xs font-body uppercase tracking-[0.25em] text-muted-foreground">Missions</p>
								<p class="font-body text-sm leading-relaxed text-foreground/85">
									Conception de contenus, soutien visuel et accompagnement de la communication de l'association.
								</p>
							</div>
						</div>
					</div>
					<div class="border border-border bg-card/60 overflow-hidden">
						<div class="p-6 md:p-8">
							<div class="inline-flex h-8 w-8 items-center justify-center rounded-sm border border-border text-muted-foreground">
								<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" d="M12 3.75l6.75 3.75v8.25L12 19.5l-6.75-3.75V7.5z" />
									<path stroke-linecap="round" stroke-linejoin="round" d="M9.75 12l1.5 1.5 3-3" />
								</svg>
							</div>
							<div class="mt-4 space-y-2">
								<p class="text-xs font-body uppercase tracking-[0.25em] text-muted-foreground">Apprentissages</p>
								<p class="font-body text-sm leading-relaxed text-foreground/85">
									Organisation, sens du detail et adaptation des messages selon les publics et les supports.
								</p>
							</div>
						</div>
					</div>
					<div class="border border-border bg-card/60 overflow-hidden">
						<div class="p-6 md:p-8">
							<div class="inline-flex h-8 w-8 items-center justify-center rounded-sm border border-border text-muted-foreground">
								<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5l2.25 4.563 5.043.732-3.647 3.553.861 5.02L12 16.995l-4.507 2.373.861-5.02-3.647-3.553 5.043-.732z" />
								</svg>
							</div>
							<div class="mt-4 space-y-2">
								<p class="text-xs font-body uppercase tracking-[0.25em] text-muted-foreground">Resultat</p>
								<p class="font-body text-sm leading-relaxed text-foreground/85">
									Une experience qui renforce ma pratique du design au service de l'interet collectif.
								</p>
							</div>
						</div>
					</div>
				</div>
			</section>



			<div class="mt-12 flex items-center justify-between gap-4 flex-wrap">
				<a href="/bde" class="text-sm font-body uppercase tracking-wider text-primary hover:text-primary/80 transition-colors">
					Voir BDE
				</a>
				<a href="/#experiences-benevoles" class="text-sm font-body uppercase tracking-wider text-muted-foreground hover:text-foreground transition-colors">
					Retour aux experiences
				</a>
			</div>
		</div>
	</article>
</BaseLayout>

<script is:inline>
	const capsPreview = document.getElementById("capsVideoPreview");
	const capsPlayer = document.getElementById("capsVideoPlayer");

	if (capsPreview && capsPlayer) {
		capsPreview.addEventListener("click", () => {
			capsPreview.classList.add("hidden");
			capsPlayer.classList.remove("hidden");

			if (capsPlayer.tagName === "VIDEO") {
				capsPlayer.play().catch(() => {});
			}
		});
	}
</script>
