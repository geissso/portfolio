---
import BaseLayout from "../layouts/BaseLayout.astro";

const capsVideoUrl = (
	import.meta.env.PUBLIC_CAPS_VIDEO_URL ||
	"https://youtu.be/1zuooNA-b8Y?si=E1BQYHWkbAi2cTUn"
).trim();

function getVideoProvider(url: string): "none" | "youtube" | "vimeo" | "file" {
	if (!url) return "none";
	if (/youtube\.com|youtu\.be/.test(url)) return "youtube";
	if (/vimeo\.com/.test(url)) return "vimeo";
	return "file";
}

function getEmbedUrl(url: string, provider: "none" | "youtube" | "vimeo" | "file"): string {
	if (provider === "youtube") {
		const shortMatch = url.match(/youtu\.be\/([A-Za-z0-9_-]+)/);
		if (shortMatch?.[1]) {
			return `https://www.youtube.com/embed/${shortMatch[1]}?rel=0`;
		}

		const longMatch = url.match(/[?&]v=([A-Za-z0-9_-]+)/);
		if (longMatch?.[1]) {
			return `https://www.youtube.com/embed/${longMatch[1]}?rel=0`;
		}

		if (url.includes("/embed/")) {
			return url.includes("autoplay=1") ? url.replace(/autoplay=1&?/, "") : url;
		}
	}

	if (provider === "vimeo") {
		const vimeoMatch = url.match(/vimeo\.com\/(\d+)/);
		if (vimeoMatch?.[1]) {
			return `https://player.vimeo.com/video/${vimeoMatch[1]}`;
		}
	}

	return "";
}

function getYouTubeVideoId(url: string): string {
	const shortMatch = url.match(/youtu\.be\/([A-Za-z0-9_-]+)/);
	if (shortMatch?.[1]) return shortMatch[1];

	const longMatch = url.match(/[?&]v=([A-Za-z0-9_-]+)/);
	if (longMatch?.[1]) return longMatch[1];

	const embedMatch = url.match(/\/embed\/([A-Za-z0-9_-]+)/);
	if (embedMatch?.[1]) return embedMatch[1];

	return "";
}

const videoProvider = getVideoProvider(capsVideoUrl);
const capsVideoEmbedUrl = getEmbedUrl(capsVideoUrl, videoProvider);
const capsVideoPreview =
	videoProvider === "youtube"
		? `https://img.youtube.com/vi/${getYouTubeVideoId(capsVideoUrl)}/hqdefault.jpg`
		: "/images/hero_caps1.webp";
const hasCapsVideo = capsVideoUrl.length > 0;
---

<BaseLayout title="CAPS" description="Experience benevole au sein de l'association CAPS.">
	<article class="pb-20 md:pb-28">
		<section class="relative isolate min-h-[58vh] md:min-h-[68vh] overflow-hidden">
			<img
				src="/images/hero_caps1.webp"
				alt="Hero CAPS"
				class="absolute inset-0 h-full w-full object-cover"
				loading="lazy"
			/>
			<div class="absolute inset-0 bg-black/10"></div>
			<div class="absolute bottom-4 right-6 z-20 text-right md:bottom-6 md:right-8">
				<p class="text-xs font-body text-white/20">
					Photo: <a href="https://www.instagram.com/splmo_7410/" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-white transition-colors">@splmo_7410</a>
				</p>
			</div>
			<div class="container relative z-10 flex min-h-[58vh] md:min-h-[68vh] flex-col justify-between px-6 pt-20 pb-8 md:pt-24 md:pb-12">
				<a
					href="/"
					class="inline-flex w-fit items-center gap-2 text-sm font-body uppercase tracking-wider text-white/90 hover:text-white transition-colors"
				>
					<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<polyline points="15 18 9 12 15 6"></polyline>
					</svg>
					Retour
				</a>
				<div>
					<p class="text-xs font-body uppercase tracking-[0.3em] text-white/80 mb-3">Experience benevole</p>
					<h1 class="font-heading text-5xl md:text-7xl text-white mb-3">CAPS</h1>
					<p class="font-body text-sm md:text-base text-white/90 max-w-xl">
						Engagement associatif, communication sensible et creations au service du collectif.
					</p>
				</div>
			</div>
		</section>

		<div class="container px-6 pt-14 md:pt-20 space-y-16 md:space-y-24">
			<section class="space-y-6">
				<div>
					<p class="text-xs font-body uppercase tracking-[0.25em] text-muted-foreground">Roles au sein de CAPS</p>
					<h2 class="font-heading text-4xl md:text-5xl text-foreground mt-2">Mes missions</h2>
					<p class="font-body text-base text-foreground/80 mt-4 max-w-3xl">
						Je suis polyvalente sur toutes les missions présentes dans l'association. Ces rôles se completent et suivant les évènements nous sommes amenés à prendre part à des rôles différents à chaque fois.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-5">
					<article class="border border-border bg-card/60 overflow-hidden">
						<div class="aspect-[4/3] overflow-hidden">
							<img
								src="/images/commentatrice_caps.webp"
								alt="Role de commentatrice a CAPS"
								class="h-full w-full object-cover"
								loading="lazy"
							/>
						</div>
						<div class="p-5 space-y-2">
							<p class="text-xs font-body uppercase tracking-[0.25em] text-muted-foreground">Commentatrice</p>
							<p class="font-body text-base text-foreground">Commentatrice</p>
							<p class="font-body text-sm leading-relaxed text-foreground/80">
								Animation des directs pendant les évènements, essayer de couvrir les blancs où les problèmes techniques qu'il peut y avoir et faire passer un bon moment aux viewers !
							</p>
						</div>
					</article>

					<article class="border border-border bg-card/60 overflow-hidden">
						<div class="aspect-[4/3] overflow-hidden">
							<img
								src="/images/logistique_caps.webp"
								alt="Role logistique a CAPS"
								class="h-full w-full object-cover"
								loading="lazy"
							/>
						</div>
						<div class="p-5 space-y-2">
							<p class="text-xs font-body uppercase tracking-[0.25em] text-muted-foreground">Logistique</p>
							<p class="font-body text-base text-foreground">Logistique</p>
							<p class="font-body text-sm leading-relaxed text-foreground/80">
								Preparation des locaux de tournage, coordination des besoins matériels et suivi opérationnel pour garantir un bon déroulement des directs.
							</p>
						</div>
					</article>

					<article class="border border-border bg-card/60 overflow-hidden">
						<div class="aspect-[4/3] overflow-hidden">
							<img
								src="/images/hero_caps1.webp"
								alt="Role regie et realisation a CAPS"
								class="h-full w-full object-cover"
								loading="lazy"
							/>
						</div>
						<div class="p-5 space-y-2">
							<p class="text-xs font-body uppercase tracking-[0.25em] text-muted-foreground">Regie / real</p>
							<p class="font-body text-base text-foreground">Regie / real</p>
							<p class="font-body text-sm leading-relaxed text-foreground/80">
								Gestion de la regie et de la realisation, c'est tout le coeur de la diffusion, proposer les bons points de vue aux bons moments, faire en sorte que le son ne soit pas saturé ou trop faible (et que tout fonctionne).
							</p>
						</div>
					</article>
				</div>
			</section>

			<section class="w-screen relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] px-6 md:px-10 py-12 md:py-16">
				<div class="mx-auto max-w-none space-y-6">
					<div class="container px-0">
						<p class="text-xs font-body uppercase tracking-[0.25em] text-muted-foreground">
						<p class="font-body text-sm text-foreground/80 max-w-2xl">
							Clique sur jouer pour lancer la video.
						</p>
					</div>

					{hasCapsVideo && (
						<div class="space-y-4" id="capsVideoSection" data-provider={videoProvider}>
							<button
								type="button"
								id="capsVideoPreview"
								class="group relative block w-full overflow-hidden"
								aria-label="Lancer la video CAPS"
							>
								<img
									src={capsVideoPreview}
									alt="Apercu video CAPS"
									class="w-full h-[58vh] md:h-[72vh] object-cover transition-transform duration-500 group-hover:scale-[1.02]"
								/>
								<div class="absolute inset-0 bg-black/35 group-hover:bg-black/25 transition-colors"></div>
								<div class="absolute inset-0 flex items-center justify-center">
									<span class="inline-flex items-center gap-3 bg-white/90 px-5 py-3 text-sm font-body uppercase tracking-wider text-black">
										<svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
											<polygon points="8,5 19,12 8,19"></polygon>
										</svg>
										Jouer la video
									</span>
								</div>
							</button>

							{videoProvider === "file" ? (
								<video
									id="capsVideoPlayer"
									class="hidden w-full h-[58vh] md:h-[72vh] object-contain bg-black"
									controls
									playsinline
									preload="metadata"
									src={capsVideoUrl}
								></video>
							) : (
								<iframe
									id="capsVideoPlayer"
									class="hidden w-full h-[58vh] md:h-[72vh] bg-black"
									title="Video CAPS"
									data-src={capsVideoEmbedUrl}
									allow="encrypted-media; picture-in-picture; fullscreen"
									allowfullscreen
								></iframe>
							)}
						</div>
					)}
				</div>
			</section>

			<section class="border border-border bg-card/60 overflow-hidden">
				<div class="grid grid-cols-1 md:grid-cols-2 divide-y divide-border md:divide-y-0 md:divide-x">
					<div class="p-6 md:p-8">
						<div class="inline-flex h-8 w-8 items-center justify-center rounded-sm border border-border text-muted-foreground">
							<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" d="M12 21s6.75-3.75 6.75-10.5A6.75 6.75 0 0 0 5.25 10.5C5.25 17.25 12 21 12 21z" />
								<path stroke-linecap="round" stroke-linejoin="round" d="M12 12a2.25 2.25 0 1 0 0-4.5 2.25 2.25 0 0 0 0 4.5z" />
							</svg>
						</div>
						<div class="mt-4 space-y-2">
							<p class="text-xs font-body uppercase tracking-[0.25em] text-muted-foreground">Contexte</p>
							<p class="font-body text-sm leading-relaxed text-foreground/85">
								CAPS est une association audio-visuelle. Sa communication doit être accessible et surtout vise les étudiants, le but est de diffuser en direct des contenus qui nous représentent et qui nous amuse.
							</p>
						</div>
					</div>
					<div class="p-6 md:p-8">
						<div class="inline-flex h-8 w-8 items-center justify-center rounded-sm border border-border text-muted-foreground">
							<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" d="M4.5 20.25l6.75-6.75m-4.5-4.5 8.25-5.25L20.25 9l-5.25 8.25-6.75 2.25-3.75-3.75z" />
							</svg>
						</div>
						<div class="mt-4 space-y-2">
							<p class="text-xs font-body uppercase tracking-[0.25em] text-muted-foreground">Notre équipe</p>
							<p class="font-body text-sm leading-relaxed text-foreground/85">
								Nous mettons un point d'honneur à rester soudés, nous avons tous une voix égale et les projets sont toujours portés par tous les membres de CAPS.
							</p>
						</div>
					</div>
				</div>
			</section>

			<div class="mt-12 flex items-center justify-between gap-4 flex-wrap">
				<a href="/bde" class="text-sm font-body uppercase tracking-wider text-primary hover:text-primary/80 transition-colors">
					Voir BDE
				</a>
				<a href="/#experiences-benevoles" class="text-sm font-body uppercase tracking-wider text-muted-foreground hover:text-foreground transition-colors">
					Retour aux experiences
				</a>
			</div>
		</div>
	</article>
</BaseLayout>

<script is:inline>
	const capsPreview = document.getElementById("capsVideoPreview");
	const capsPlayer = document.getElementById("capsVideoPlayer");

	if (capsPreview && capsPlayer) {
		capsPreview.addEventListener("click", () => {
			// For iframe embeds, assign src from data-src but don't force autoplay
			if (capsPlayer.tagName === "IFRAME") {
				const src = capsPlayer.dataset && capsPlayer.dataset.src;
				if (src) capsPlayer.setAttribute("src", src);
				capsPreview.classList.add("hidden");
				capsPlayer.classList.remove("hidden");
				return;
			}

			// For native video, reveal and play (user initiated)
			capsPreview.classList.add("hidden");
			capsPlayer.classList.remove("hidden");
			if (capsPlayer.tagName === "VIDEO") {
				capsPlayer.play().catch(() => {});
			}
		});
	}
</script>
