---
import BaseLayout from "../layouts/BaseLayout.astro";

const capsVideoUrl = (
	import.meta.env.PUBLIC_CAPS_VIDEO_URL ||
	"https://youtu.be/1zuooNA-b8Y?si=E1BQYHWkbAi2cTUn"
).trim();

function getVideoProvider(url: string): "none" | "youtube" | "vimeo" | "file" {
	if (!url) return "none";
	if (/youtube\.com|youtu\.be/.test(url)) return "youtube";
	if (/vimeo\.com/.test(url)) return "vimeo";
	return "file";
}

function getEmbedUrl(url: string, provider: "none" | "youtube" | "vimeo" | "file"): string {
	if (provider === "youtube") {
		const shortMatch = url.match(/youtu\.be\/([A-Za-z0-9_-]+)/);
		if (shortMatch?.[1]) {
			return `https://www.youtube.com/embed/${shortMatch[1]}?autoplay=1&rel=0`;
		}

		const longMatch = url.match(/[?&]v=([A-Za-z0-9_-]+)/);
		if (longMatch?.[1]) {
			return `https://www.youtube.com/embed/${longMatch[1]}?autoplay=1&rel=0`;
		}

		if (url.includes("/embed/")) {
			return url.includes("autoplay=1") ? url : `${url}${url.includes("?") ? "&" : "?"}autoplay=1`;
		}
	}

	if (provider === "vimeo") {
		const vimeoMatch = url.match(/vimeo\.com\/(\d+)/);
		if (vimeoMatch?.[1]) {
			return `https://player.vimeo.com/video/${vimeoMatch[1]}?autoplay=1`;
		}
	}

	return "";
}

function getYouTubeVideoId(url: string): string {
	const shortMatch = url.match(/youtu\.be\/([A-Za-z0-9_-]+)/);
	if (shortMatch?.[1]) return shortMatch[1];

	const longMatch = url.match(/[?&]v=([A-Za-z0-9_-]+)/);
	if (longMatch?.[1]) return longMatch[1];

	const embedMatch = url.match(/\/embed\/([A-Za-z0-9_-]+)/);
	if (embedMatch?.[1]) return embedMatch[1];

	return "";
}

const videoProvider = getVideoProvider(capsVideoUrl);
const capsVideoEmbedUrl = getEmbedUrl(capsVideoUrl, videoProvider);
const capsVideoPreview =
	videoProvider === "youtube"
		? `https://img.youtube.com/vi/${getYouTubeVideoId(capsVideoUrl)}/hqdefault.jpg`
		: "/images/hero_caps1.webp";
const hasCapsVideo = capsVideoUrl.length > 0;
---

<BaseLayout title="CAPS" description="Experience benevole au sein de l'association CAPS.">
	<article class="pb-20 md:pb-28">
		<section class="relative isolate min-h-[58vh] md:min-h-[68vh] overflow-hidden">
			<img
				src="/images/hero_caps1.webp"
				alt="Hero CAPS"
				class="absolute inset-0 h-full w-full object-cover"
				loading="eager"
			/>
			<div class="absolute inset-0 bg-black/10"></div>
					) : null}
					Photo: <a href="https://www.instagram.com/splmo_7410/" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-white transition-colors">@splmo_7410</a>
				</p>
			</div>
			<div class="container relative z-10 flex min-h-[58vh] md:min-h-[68vh] flex-col justify-between px-6 pt-20 pb-8 md:pt-24 md:pb-12">
				<a
					href="/"
